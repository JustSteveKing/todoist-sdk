{
    "name": "juststeveking/todoist-sdk",
    "description": "PHP SDK for Todoist's API v1, built on sdk-toolbox. Not created by, affiliated with, or supported by Todoist.",
    "keywords": [
        "todoist",
        "sdk",
        "api",
        "php",
        "psr-18"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Steve McDougall",
            "email": "steve@juststeveking.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "cuyz/valinor": "^2.6",
        "juststeveking/sdk-toolbox": "^0.0.7"
    },
    "require-dev": {
        "laravel/pint": "^1.25",
        "nyholm/psr7": "^1.8",
        "pestphp/pest": "^4.1",
        "phpstan/phpstan": "^2.1",
        "symfony/http-client": "^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "JustSteveKing\\TodoistSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JustSteveKing\\TodoistSdk\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "lint": "pint --test",
        "spec:check": "php bin/spec check",
        "spec:update": "php bin/spec update"
    }
}
